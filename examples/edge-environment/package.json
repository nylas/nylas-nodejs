{
  "name": "nylas-cloudflare-worker-attachments",
  "version": "1.0.0",
  "description": "Cloudflare Worker example for sending email attachments using Nylas SDK",
  "main": "src/worker.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
